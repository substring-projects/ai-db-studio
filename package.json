{
  "name": "ai-db-studio",
  "version": "0.2.1",
  "description": "Safe, local-first database studio for PostgreSQL and MySQL with AI schema grounding",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test test/*.test.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder -mw",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "mysql2": "^3.12.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/ollama": "^1.3.0",
    "@langchain/openai": "^1.8.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "monaco-editor": "^0.57.0",
    "postcss": "^8.5.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.18.1",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.9.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "zod": "^4.6.7"
  }
}
